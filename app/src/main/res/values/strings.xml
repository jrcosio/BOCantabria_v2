    <string name="ai_summary_quota_wait">Se ha alcanzado el límite por minuto. Continuaremos en unos %1$d s.</string>

    <!--
      Cobertura parcial: se avisa antes de gastar la petición y se dice después.
      En plural de verdad: «Se analizarán las 1 primeras» es lo que sale si no se hace, y es un caso
      que ocurre —un documento largo del que solo cabe la primera página—.
    -->
    <plurals name="ai_summary_partial_before">
        <item quantity="one">Documento de %1$d páginas. Se analizará solo la primera.</item>
        <item quantity="other">Documento de %1$d páginas. Se analizarán las %2$d primeras.</item>
    </plurals>
    <plurals name="ai_summary_partial_after">
        <item quantity="one">Se ha analizado la página %1$s de %2$d. El resumen no cubre el documento completo.</item>
        <item quantity="other">Se han analizado las páginas %1$s de %2$d. El resumen no cubre el documento completo.</item>
    </plurals>
